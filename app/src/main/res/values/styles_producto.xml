<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Formulario de producto a pantalla completa (DialogFragment). -->
    <style name="Theme.Changarrito.Acceso.PantallaCompleta" parent="Theme.Changarrito.Acceso">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/acceso_fondo</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Producto.Chip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/marca_verde_oscuro</item>
        <item name="strokeColor">@color/acceso_borde</item>
        <item name="backgroundTint">@color/acceso_superficie</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
