<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema de las pantallas de acceso: fondo crema y barra de estado clara. -->
    <style name="Theme.Changarrito.Acceso" parent="Theme.Changarrito">
        <item name="colorPrimary">@color/marca_verde</item>
        <item name="colorPrimaryVariant">@color/marca_verde_oscuro</item>
        <item name="colorSecondary">@color/marca_ambar</item>
        <item name="colorError">@color/acceso_error</item>
        <item name="android:windowBackground">@color/acceso_fondo</item>
        <item name="android:statusBarColor">@color/acceso_fondo</item>
        <item name="android:navigationBarColor">@color/acceso_fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/acceso_texto</item>
    </style>

    <style name="Acceso.Titulo" parent="">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/acceso_texto</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Acceso.Subtitulo" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/acceso_texto_secundario</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Acceso.Etiqueta" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/acceso_texto</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Campo de texto: caja blanca redondeada con borde suave. -->
    <style name="Acceso.Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/acceso_superficie</item>
        <item name="boxStrokeColor">@color/marca_verde</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/acceso_error</item>
        <item name="endIconTint">@color/acceso_texto_secundario</item>
    </style>

    <style name="Acceso.CampoTexto" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/acceso_texto</item>
        <item name="android:textColorHint">@color/acceso_texto_pista</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Acceso.BotonPrincipal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/marca_verde</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Acceso.BotonGoogle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/acceso_texto</item>
        <item name="backgroundTint">@color/acceso_superficie</item>
        <item name="strokeColor">@color/acceso_borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="Acceso.Enlace" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/marca_verde</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

</resources>
