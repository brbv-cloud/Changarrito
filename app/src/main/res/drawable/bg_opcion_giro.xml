<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de opción: borde turquesa grueso cuando está elegida. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/acceso_superficie" />
            <stroke android:width="2dp" android:color="@color/marca_verde" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/acceso_superficie" />
            <stroke android:width="1dp" android:color="@color/acceso_borde" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
