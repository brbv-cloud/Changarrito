<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Encabezado de día: solo se muestra en la primera entrada de cada fecha. -->
    <TextView
        android:id="@+id/tvDia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/acceso_texto_secundario"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tarjeta_info"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvHora"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/marca_verde"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTexto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/acceso_texto"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
