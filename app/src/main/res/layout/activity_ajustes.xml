<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAjustes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acceso_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/acceso_volver"
            android:src="@drawable/ic_atras" />

        <TextView
            style="@style/Acceso.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ajustes_titulo" />

        <!-- Turno -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_tarjeta_info"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvInicialTurno"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/marca_verde_oscuro"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTurnoActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/acceso_texto"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvRolTurno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/acceso_texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarTurno"
            style="@style/Acceso.BotonGoogle"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/ajustes_cambiar_turno"
            app:icon="@drawable/ic_cambiar_turno" />

        <!-- Negocio (solo dueño) -->
        <LinearLayout
            android:id="@+id/seccionNegocio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/ajustes_seccion_negocio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivGiro"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icono_tinte"
                    android:importantForAccessibility="no"
                    android:scaleType="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreNegocio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/acceso_texto"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvGiroCuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/acceso_texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBitacora"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/bitacora_abrir"
                app:icon="@drawable/ic_reloj" />

            <!-- Equipo -->
            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/ajustes_seccion_equipo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/ajustes_equipo_ayuda"
                android:textColor="@color/acceso_texto_secundario"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/contenedorEquipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgregarTrabajador"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/ajustes_agregar_trabajador"
                app:icon="@drawable/ic_persona_mas" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMiClave"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/ajustes_mi_clave"
                app:icon="@drawable/ic_llave" />

            <!-- Cuenta -->
            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/ajustes_seccion_cuenta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:text="@string/ajustes_cerrar_sesion"
                android:textColor="@color/acceso_error"
                app:icon="@drawable/ic_salir" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAcerca"
            style="@style/Acceso.Enlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/ajustes_acerca" />
    </LinearLayout>
</ScrollView>
