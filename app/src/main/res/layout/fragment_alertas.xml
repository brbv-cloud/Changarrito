<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootAlertas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_alt"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_bg"
        android:padding="16dp"
        android:text="Alertas"
        android:textColor="@color/color_slate_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlertas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/tvSinAlertas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="No hay alertas activas por ahora"
            android:textColor="@color/color_slate_medium"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
