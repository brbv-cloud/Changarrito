<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño: "Changarrito · Acceso". Pie anclado abajo cuando cabe; con teclado o
     pantallas chicas todo se desplaza (fillViewport + espacio flexible). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootVerificar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acceso_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="72dp"
                android:background="@drawable/bg_icono_tinte"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_correo" />

            <TextView
                style="@style/Acceso.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/verificar_titulo" />

            <TextView
                android:id="@+id/tvSubtitulo"
                style="@style/Acceso.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/acceso_error"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYaVerifique"
                style="@style/Acceso.BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                android:text="@string/verificar_ya_verifique" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReenviar"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/verificar_reenviar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tarjeta_info"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/verificar_ayuda"
                    android:textColor="@color/acceso_texto"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtraCuenta"
            style="@style/Acceso.Enlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/verificar_otra_cuenta"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
