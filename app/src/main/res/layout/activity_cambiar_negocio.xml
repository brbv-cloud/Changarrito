<?xml version="1.0" encoding="utf-8"?>
<!-- Entra una cuenta distinta a la del negocio que ya tiene el celular. Mismo estilo de Acceso. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCambio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acceso_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="56dp"
            android:background="@drawable/bg_icono_tinte"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_cambiar_turno"
            app:tint="@color/marca_verde" />

        <TextView
            style="@style/Acceso.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cambio_titulo" />

        <TextView
            android:id="@+id/tvSubtitulo"
            style="@style/Acceso.Subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cambio_cargando" />

        <TextView
            android:id="@+id/tvRespaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chip_estado"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cajaConsejo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta_info"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/cambio_consejo"
                android:textColor="@color/acceso_texto"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEtiquetaClave"
            style="@style/Acceso.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etClave"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAyudaClave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cambio_clave_ayuda"
            android:textColor="@color/acceso_texto_secundario"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilClave"
            style="@style/Acceso.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:counterEnabled="true"
            app:counterMaxLength="4">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClave"
                style="@style/Acceso.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberPassword"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbEntiendo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/cambio_entiendo"
            android:textColor="@color/acceso_texto"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/acceso_error"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBorrar"
            style="@style/Acceso.BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:text="@string/cambio_borrar"
            app:backgroundTint="@color/acceso_error" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvOtraCuenta"
            style="@style/Acceso.Enlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/cambio_otra_cuenta"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
