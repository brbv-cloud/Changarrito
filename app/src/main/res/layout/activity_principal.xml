<?xml version="1.0" encoding="utf-8"?>
<!-- La app ya adentro: aqui se intercambian las cinco secciones; la barra de abajo es fija. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_alt"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorSecciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/barra_navegacion" />
</LinearLayout>
