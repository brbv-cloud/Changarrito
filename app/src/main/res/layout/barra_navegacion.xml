<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegacion de abajo, compartida por Inicio, Inventario, Vender, Alertas y Reportes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_card_stroke" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_bg"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacion" />
</LinearLayout>
