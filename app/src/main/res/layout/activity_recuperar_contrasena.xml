<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño: "Changarrito · Acceso". Pie anclado abajo cuando cabe; con teclado o
     pantallas chicas todo se desplaza (fillViewport + espacio flexible). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRecuperar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acceso_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnAtras"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/acceso_volver"
                android:src="@drawable/ic_atras" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_icono_tinte"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_candado" />

            <TextView
                style="@style/Acceso.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/recuperar_titulo" />

            <TextView
                style="@style/Acceso.Subtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recuperar_subtitulo" />

            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:labelFor="@id/etCorreo"
                android:text="@string/acceso_correo" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Acceso.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    style="@style/Acceso.CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acceso_correo_pista"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/acceso_error"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/marca_verde"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviar"
                style="@style/Acceso.BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/recuperar_enviar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_tarjeta_info"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/recuperar_ayuda"
                    android:textColor="@color/acceso_texto"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recuperar_ya_la_recordaste"
                android:textColor="@color/acceso_texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvIniciaSesion"
                style="@style/Acceso.Enlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="@string/registro_inicia_sesion"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
