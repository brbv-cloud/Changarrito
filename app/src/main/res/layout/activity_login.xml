<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño: "Changarrito · Acceso". Pie anclado abajo cuando cabe; con teclado o
     pantallas chicas todo se desplaza (fillViewport + espacio flexible). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/acceso_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Logo completo (ícono + nombre + lema "Tu tiendita, bajo control"),
                 por eso aquí ya no van el título ni el subtítulo en texto. -->
            <ImageView
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/acceso_logo_descripcion"
                android:src="@drawable/logo_changarrito" />

            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etCorreo"
                android:text="@string/acceso_correo" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/Acceso.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    style="@style/Acceso.CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acceso_correo_pista"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Acceso.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etContrasena"
                android:text="@string/acceso_contrasena" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContrasena"
                style="@style/Acceso.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    style="@style/Acceso.CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/acceso_contrasena_pista"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvOlvidaste"
                style="@style/Acceso.Enlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="-8dp"
                android:text="@string/acceso_olvidaste" />
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/acceso_error"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarSesion"
                style="@style/Acceso.BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/acceso_iniciar_sesion" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/acceso_borde" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/acceso_o"
                    android:textColor="@color/acceso_texto_secundario"
                    android:textSize="15sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/acceso_borde" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Acceso.BotonGoogle"
                android:layout_width="match_parent"
                android:text="@string/acceso_continuar_google"
                app:icon="@drawable/ic_google" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acceso_sin_cuenta"
                android:textColor="@color/acceso_texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRegistrate"
                style="@style/Acceso.Enlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:text="@string/acceso_registrate"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
