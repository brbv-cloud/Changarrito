<?xml version="1.0" encoding="utf-8"?>
<!-- Alerta: franja de color a la izquierda (roja = urgente, ambar = pronto), tipo en
     mayusculas, producto, detalle y acciones. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/color_bg"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_card_stroke"
    app:strokeWidth="@dimen/card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/franja"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/status_ambar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivIconoAlerta"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_inventario" />

                <TextView
                    android:id="@+id/tvTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.06"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="STOCK BAJO" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNombreProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_slate_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Leche Alpura 1L" />

            <TextView
                android:id="@+id/tvMensajeAlerta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/color_slate_medium"
                android:textSize="14sp"
                tools:text="Quedan 2 PZA · mínimo 5" />

            <!-- Solo en "Atendidas": quien y cuando. -->
            <TextView
                android:id="@+id/tvAtendida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:textColor="@color/semaforo_verde_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/filaAcciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContactarProveedor"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/alerta_pedir"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@color/marca_verde"
                    app:cornerRadius="12dp" />

                <!-- Boton con borde: antes era solo texto y no parecia boton. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResolver"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/alerta_resolver"
                    android:textAllCaps="false"
                    android:textColor="@color/marca_verde_oscuro"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/acceso_tinte_verde"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_check_circulo"
                    app:iconSize="18dp"
                    app:iconTint="@color/marca_verde_oscuro"
                    app:strokeColor="@color/marca_verde"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
