<?xml version="1.0" encoding="utf-8"?>
<!-- Renglón de perfil: lo usan "¿Quién atiende?" y la lista de equipo en Ajustes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_opcion_giro"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvInicial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/marca_verde_oscuro"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/acceso_texto"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/acceso_texto_secundario"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAccion"
        style="@style/Acceso.Enlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/acceso_error"
        android:visibility="gone" />
</LinearLayout>
